local UPDATE_JSON_URL = "https://raw.githubusercontent.com/caiox8221-maker/UPDATE6.json/refs/heads/main/UPDATE6.json"

local function CheckUpdate()

    local success, result = pcall(function()

        local response = game:HttpGet(UPDATE_JSON_URL)

        local HttpService = game:GetService("HttpService")
        local data = HttpService:JSONDecode(response)

        assert(type(data) == "table", "JSON invalido")

        if data.status ~= "active" then
            return {
                blocked = true,
                message = "Sistema temporariamente indisponivel."
            }
        end

        local release = DateTime.fromIsoDate(data.releaseDate)
        local validHours = tonumber(data.validHours)

        assert(validHours and validHours > 0, "Validade invalida")

        local expiration =
            release.UnixTimestamp + (validHours * 3600)

        local expired = os.time() >= expiration

        local outdated =
            data.updateAvailable == true
            or data.latestVersion ~= CURRENT_VERSION
            or expired

        return {
            blocked = outdated,
            message = data.message or "Atualize o LNS HUB!",
            updateUrl = data.updateUrl
        }

    end)

    if not success then
        warn("[LNS UPDATE] Falha na verificação: " .. tostring(result))

        return {
            blocked = false,
            error = true
        }
    end

    return result
end


local function bindSlider(bar, onX)
	local sliding = false
	table.insert(conns, bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			onX(i.Position.X)
		end
	end))
	table.insert(conns, UIS.InputChanged:Connect(function(i)
		if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			onX(i.Position.X)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end))
end

function sliderRow(page, order, name, minV, maxV, defV, fmt, onChange)
	local row = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = ROW, BorderSizePixel = 0, LayoutOrder = order,
	}, pages[page])
	rnd(row, 10)
	local lbl = txt(row, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22), TextSize = 13 })
	local bar = mk("Frame", {
		Position = UDim2.fromOffset(12, 40), Size = UDim2.new(1, -24, 0, 8), BackgroundColor3 = OFFSW,
		BorderSizePixel = 0, Active = true,
	}, row)
	rnd(bar, 4)
	local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ORANGE, BorderSizePixel = 0 }, bar)
	rnd(fill, 4)
	local knob = mk("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, -7, 0.5, -7),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, bar)
	rnd(knob, 7)
	local value = defV
	local function render()
		local rel = (value - minV) / (maxV - minV)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, -7, 0.5, -7)
		lbl.Text = name .. ": " .. fmt(value)
	end
	bindSlider(bar, function(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		value = math.floor(minV + rel * (maxV - minV) + 0.5)
		render()
		pcall(onChange, value)
	end)
	render()
	table.insert(rowsOf[page], { row, name })
end


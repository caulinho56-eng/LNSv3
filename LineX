	end
	if pressed then return end
	pressed = true
	AIM.holdTouch = true
	btnPaint(true)
end

local function pressOff()
	dragArmed = false
	dragInput = nil
	holdInput = nil
	if pressed then
		pressed = false
		AIM.holdTouch = false
		btnPaint(false)
	end
end


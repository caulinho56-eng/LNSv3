		local my = rootOf(LP)
		if not my then return end
		savedCF = my.CFrame
		hbConn = RunService.Heartbeat:Connect(function()
			local m, t = rootOf(LP), getTarget()
			if not (m and t) then return end
			m.CFrame = t.CFrame + t.AssemblyLinearVelocity * 0.12

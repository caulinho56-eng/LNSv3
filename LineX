local lockA, lastCol, rot = 0, nil, 0
table.insert(conns, RunService.RenderStepped:Connect(function(dt)
	local show = AIM.showFov and (AIM.on or curPage == "Aimbot")
	if fovRing.Visible ~= show then fovRing.Visible = show end
	local btnShow = AIM.hold and UIS.TouchEnabled and (AIM.on or AIM.moveBtn)
	if aimBtn.Visible ~= btnShow then aimBtn.Visible = btnShow end
	if not btnShow and (pressed or dragInput or dragArmed) then pressOff() end
	if btnShow then
		local lk = AIM.on and AIM.holdTouch and AIM.target ~= nil
		local key = (AIM.moveBtn and "M" or (AIM.holdTouch and "P" or "I")) .. (lk and "L" or "")
		if key ~= lastBtnKey then
			lastBtnKey = key
			paintAimBtn(key)
		end
	end
	if not show then return end
	local active = AIM.active()
	local locked = AIM.on and active and AIM.target ~= nil
	lockA += ((locked and 1 or 0) - lockA) * math.clamp(dt * 12, 0, 1)
	local base = AIM.col
	if AIM.rainbow then base = Color3.fromHSV((os.clock() * 0.25) % 1, 0.85, 1) end
	local c = base:Lerp(AIM.lockCol, lockA)
	if c ~= lastCol then
		lastCol = c
		fovGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c),
			ColorSequenceKeypoint.new(0.5, c:Lerp(Color3.new(1, 1, 1), 0.45)),
			ColorSequenceKeypoint.new(1, c),
		})
		fovRing.BackgroundColor3 = c
		fovDot.BackgroundColor3 = c
	end
	rot = (rot + dt * 40) % 360
	fovGrad.Rotation = rot
	local d = AIM.fov * 2 * (1 - 0.04 * lockA)
	fovRing.Size = UDim2.fromOffset(d, d)
	fovRing.BackgroundTransparency = 1 - AIM.fill / 100
	fovStroke.Thickness = AIM.thick + lockA * 1.5
	fovStroke.Transparency = (AIM.on and not active) and 0.55 or 0
	fovDot.Visible = AIM.dot
	local ctr = aimCenter()
	fovRing.Position = UDim2.fromOffset(ctr.X, ctr.Y)
end))


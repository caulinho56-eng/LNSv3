							blocked("Shutdown")
							return nil
						end
						if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" and banRemote(self) then
							blocked("Remote " .. self.Name)
							return nil
						end
					end
				end
				return old(self, ...)
			end))
		end)
		if not okh then return false end
		pcall(function()
			if hookfunction then
				local oldKick
				oldKick = hookfunction(LP.Kick, wrap(function(self, ...)
					if AK.kick and self == LP and not (checkcaller and checkcaller()) then
						blocked("Kick")
						return nil
					end

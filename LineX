local fbOn, fbId, fbSave = false, 0, nil
local fbConn = nil
local fbBright = 3
local FB_AMB = Color3.fromRGB(245, 245, 245)

local function applyFb()
	if Lighting.Brightness ~= fbBright then Lighting.Brightness = fbBright end
	if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
	if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
	if Lighting.Ambient ~= FB_AMB then Lighting.Ambient = FB_AMB end
	if Lighting.OutdoorAmbient ~= FB_AMB then Lighting.OutdoorAmbient = FB_AMB end
	if Lighting.ExposureCompensation < 0.3 then Lighting.ExposureCompensation = 0.3 end
end

function setFullbright(v)
	fbOn = v
	fbId += 1
	if fbConn then
		fbConn:Disconnect()
		fbConn = nil
	end
	if v then
		if nightOn and nightSetUi then nightSetUi(false) end
		fbSave = {
			Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows,
			Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.ExposureCompensation,
		}
		fbConn = RunService.RenderStepped:Connect(function() pcall(applyFb) end)
	elseif fbSave then
		local s = fbSave
		fbSave = nil
		pcall(function()
			Lighting.Brightness = s[1]
			Lighting.ClockTime = s[2]
			Lighting.GlobalShadows = s[3]
			Lighting.Ambient = s[4]
			Lighting.OutdoorAmbient = s[5]
			Lighting.ExposureCompensation = s[6]
		end)
	end
end

local function setNightX(v)
	if v and fbOn and fbSetUi then fbSetUi(false) end
	setNight(v)
end

local fogOn, fogId, fogSave = false, 0, nil
local atmoSave = setmetatable({}, { __mode = "k" })

local function applyFog()
	Lighting.FogEnd = 9e9
	for _, a in ipairs(Lighting:GetChildren()) do
		if a:IsA("Atmosphere") then
			if not atmoSave[a] then atmoSave[a] = { a.Density, a.Haze, a.Glare } end
			a.Density = 0
			a.Haze = 0
			a.Glare = 0
		end
	end
end

function setFog(v)
	fogOn = v
	fogId += 1
	local id = fogId
	if v then
		fogSave = { Lighting.FogEnd, Lighting.FogStart }
		task.spawn(function()
			while fogOn and id == fogId do
				pcall(applyFog)
				task.wait(1)
			end
		end)
	elseif fogSave then
		local s = fogSave
		fogSave = nil
		pcall(function()
			Lighting.FogEnd = s[1]
			Lighting.FogStart = s[2]
		end)
		for a, o in pairs(atmoSave) do
			pcall(function()
				a.Density = o[1]
				a.Haze = o[2]
				a.Glare = o[3]
			end)
		end
		atmoSave = setmetatable({}, { __mode = "k" })
	end
end

local xrayOn, xrayId, xrayConn = false, 0, nil
local xrayAlpha = 0.6
local xrayParts = {}

local function xrayApply(p)
	if not p:IsA("BasePart") or p:IsA("Terrain") then return end
	if charOf(p) then return end
	xrayParts[p] = true
	p.LocalTransparencyModifier = xrayAlpha
end

function setXray(v)
	xrayOn = v
	xrayId += 1
	local id = xrayId
	if xrayConn then
		xrayConn:Disconnect()
		xrayConn = nil
	end
	if v then
		xrayConn = WS.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				task.delay(0.3, function()
					if xrayOn and id == xrayId and d.Parent then pcall(xrayApply, d) end
				end)
			end
		end)
		task.spawn(function()
			local list = WS:GetDescendants()
			for i, d in ipairs(list) do
				if not (xrayOn and id == xrayId) then return end
				if d:IsA("BasePart") then pcall(xrayApply, d) end
				if i % 400 == 0 then task.wait() end
			end
		end)
	else
		local old = xrayParts
		xrayParts = {}
		local last = xrayAlpha
		task.spawn(function()
			local n = 0
			for p in pairs(old) do
				pcall(function() p.LocalTransparencyModifier = 0 end)
				n += 1
				if n % 400 == 0 then task.wait() end
			end

			local list = WS:GetDescendants()
			for i, d in ipairs(list) do
				if xrayOn then return end
				if d:IsA("BasePart") and not charOf(d) then
					local okv, cur = pcall(function() return d.LocalTransparencyModifier end)
					if okv and cur ~= 0 and math.abs(cur - last) < 0.01 then
						pcall(function() d.LocalTransparencyModifier = 0 end)
					end
				end
				if i % 400 == 0 then task.wait() end
			end
		end)
	end
end

local function setXrayAlpha(pct)
	xrayAlpha = pct / 100
	if not xrayOn then return end
	local id = xrayId
	task.spawn(function()
		local n = 0
		for p in pairs(xrayParts) do
			if not (xrayOn and id == xrayId) then return end
			pcall(function() p.LocalTransparencyModifier = xrayAlpha end)
			n += 1
			if n % 400 == 0 then task.wait() end
		end
	end)
end


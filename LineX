		orig[o] = orig[o] or {}
		orig[o][p] = old
	end
	pcall(function() o[p] = v end)
end

local function adaptLoad(dt)
	if type(dt) ~= "number" or dt <= 0 then return end
	local f = math.clamp(1 / dt, 1, 240)
	AL.fps = AL.fps * 0.8 + f * 0.2
	AL.ref = math.max(20, math.max(AL.fps, AL.ref * 0.97))
	if AL.fps < AL.ref * 0.6 then
		AL.batch = math.max(CFG.BATCH_MIN, math.floor(AL.batch * 0.8))
	elseif AL.fps < AL.ref * 0.85 then
		AL.batch = math.max(CFG.BATCH_MIN, AL.batch - 20)
	else
		AL.batch = math.min(CFG.BATCH_MAX, AL.batch + 40)
	end
end

local function flushRestore(limit)
	local n = 0
	while AL.restoreRead <= AL.restoreN and (not limit or n < limit) do
		local e = AL.restoreList[AL.restoreRead]
		AL.restoreList[AL.restoreRead] = nil
		AL.restoreRead += 1
		n += 1
		if e then
			pcall(function()
				if e[1] and (e[2] ~= "Parent" or (e[3] and e[3].Parent)) then
					e[1][e[2]] = e[3]
				end
			end)
		end
	end
	if AL.restoreRead > AL.restoreN then
		AL.restoreList = {}
		AL.restoreRead, AL.restoreN = 1, 0
		return false
	end
	return true
end

local function startRestore()
	if AL.restoreRunning then return end
	AL.restoreRunning = true
	task.spawn(function()
		local fails = 0
		while AL.restoreRead <= AL.restoreN do
			local ok = pcall(flushRestore, math.max(CFG.BATCH_MIN, AL.batch))
			if not ok then
				fails += 1
				if fails >= 3 then
					AL.restoreList = {}
					AL.restoreRead, AL.restoreN = 1, 0
					break
				end
			end
			adaptLoad(task.wait())
		end
		AL.restoreRunning = false
	end)
end

local function undoAll()
	local old = orig
	orig = setmetatable({}, { __mode = "k" })
	for o, t in pairs(old) do
		for p, v in pairs(t) do
			AL.restoreN += 1
			AL.restoreList[AL.restoreN] = { o, p, v }
		end
	end
	startRestore()
end


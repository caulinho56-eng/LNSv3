local TORSO_NAMES = { "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso" }
local ALL_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart",
	"LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg",
	"Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local aimRP = RaycastParams.new()
aimRP.FilterType = Enum.RaycastFilterType.Exclude
aimRP.RespectCanCollide = true

local function aimCenter()
	local cam = WS.CurrentCamera
	if UIS.TouchEnabled or UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
		return cam and (cam.ViewportSize / 2) or Vector2.new(400, 250)
	end
	return UIS:GetMouseLocation()
end

local function aimPartsOf(c)
	if AIM.partMode == 1 then
		local p = c:FindFirstChild("Head")
		return (p and p:IsA("BasePart")) and { p } or {}
	elseif AIM.partMode == 2 then
		for _, n in ipairs(TORSO_NAMES) do
			local p = c:FindFirstChild(n)
			if p and p:IsA("BasePart") then return { p } end
		end
		return {}
	end
	local out = {}
	for _, n in ipairs(ALL_PARTS) do
		local p = c:FindFirstChild(n)
		if p and p:IsA("BasePart") then out[#out + 1] = p end
	end
	return out
end

local function aimVisible(part, char)
	local cam = WS.CurrentCamera
	local origin = cam.CFrame.Position
	aimRP.FilterDescendantsInstances = { char, LP.Character }
	return WS:Raycast(origin, part.Position - origin, aimRP) == nil
end

local function aimPick()
	local cam = WS.CurrentCamera
	local me = LP.Character
	if not (cam and me and me:FindFirstChild("HumanoidRootPart")) then return nil end
	local camPos = cam.CFrame.Position
	local center = aimCenter()
	local bestC, bestP, bestD = nil, nil, AIM.fov
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and not (AIM.team and LP.Team and p.Team == LP.Team) then
			local c = p.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then
				for _, part in ipairs(aimPartsOf(c)) do
					local v, vis = cam:WorldToViewportPoint(part.Position)
					if vis and v.Z > 0 and (part.Position - camPos).Magnitude <= AIM.range then
						local d = (Vector2.new(v.X, v.Y) - center).Magnitude
						if d < bestD and (not AIM.wall or aimVisible(part, c)) then
							bestC, bestP, bestD = c, part, d
						end
					end
				end
			end
		end
	end
	return bestC, bestP
end

function AIM.active()
	if not AIM.on then return false end
	if not AIM.hold then return true end
	return AIM.holdTouch or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

local function setAimbot(v)
	AIM.on = v
	AIM.target = nil
	if AIM.conn then
		AIM.conn:Disconnect()
		AIM.conn = nil
	end
	if not v then return end
	AIM.conn = RunService.RenderStepped:Connect(function(dt)
		if not AIM.active() then
			AIM.target = nil
			return
		end
		local cam = WS.CurrentCamera
		if not cam then return end
		local c, part = aimPick()
		AIM.target = c
		if not part then return end
		local pos = part.Position + part.AssemblyLinearVelocity * AIM.pred
		local a = math.clamp(1 - AIM.smooth / 100, 0.02, 1)
		a = 1 - (1 - a) ^ (math.clamp(dt, 0, 0.1) * 60)
		cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, pos), a)
	end)
end


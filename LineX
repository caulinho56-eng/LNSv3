end

function toggleRow(page, order, name, onChange, init)
	local row = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = ROW, Text = "", AutoButtonColor = false,
		BorderSizePixel = 0, LayoutOrder = order,
	}, pages[page])
	rnd(row, 10)
	txt(row, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0), Text = name, TextSize = 13 })
	local setV = makeSw(row, UDim2.new(1, -54, 0.5, -10))
	local state = init == true
	if state then setV(true) end
	table.insert(conns, row.MouseButton1Click:Connect(function()
		state = not state
		setV(state)
		pcall(onChange, state)
	end))
	table.insert(rowsOf[page], { row, name })
	return row, function(v)
		v = v and true or false
		if v == state then return end
		state = v
		setV(v)
		pcall(onChange, v)
	end
end


function makeSw(parent, pos)
	local sw = mk("Frame", {
		Position = pos, Size = UDim2.fromOffset(40, 20), BackgroundColor3 = OFFSW, BorderSizePixel = 0,
	}, parent)
	rnd(sw, 10)
	local kn = mk("Frame", {
		Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 2, 0.5, -8),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, sw)
	rnd(kn, 8)
	return function(v)
		TweenService:Create(sw, TweenInfo.new(0.18), { BackgroundColor3 = v and ORANGE or OFFSW }):Play()
		TweenService:Create(kn, TweenInfo.new(0.18), {
			Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),

end

function H.hideHair(acc)

	for _, d in ipairs(acc:GetDescendants()) do
		if d:IsA("MeshPart") then
			setP(d, "TextureID", "")
		elseif d:IsA("SpecialMesh") then
			setP(d, "TextureId", "")
		elseif d:IsA("Decal") or d:IsA("Texture") then
			setP(d, "Transparency", 1)
		elseif d:IsA("SurfaceAppearance") then
			local parent = d.Parent
			if parent then
				shaderHold[d] = parent
				d.Parent = nil
			end
		end
	end
end

function H.isWalkTrack(track)
	local ok, res = pcall(function()
		if H.nameHas(track.Name, CFG.WALK_KEYS) then return true end
		local anim = track.Animation
		if anim then
			if H.nameHas(anim.Name, CFG.WALK_KEYS) then return true end
			if anim.Parent and H.nameHas(anim.Parent.Name, CFG.WALK_KEYS) then return true end
			local id = string.match(tostring(anim.AnimationId), "%d+")
			if id and CFG.WALK_IDS[id] then return true end
		end
		return false
	end)
	if not ok then return true end
	return res == true
end

function H.stopUnlessWalk(track)
	if H.isWalkTrack(track) then return end
	pcall(function() track:Stop(0) end)
end

local function trackAntiLagConnection(connection, owner)
	if connection then table.insert(antiLagConnections, { c = connection, o = owner }) end
	return connection
end

local function pruneConnections()
	local kept = {}
	for _, e in ipairs(antiLagConnections) do
		local c, o = e.c, e.o
		local dead = (c == nil) or (c.Connected == false) or (o ~= nil and o.Parent == nil)
		if dead then
			pcall(function() if c then c:Disconnect() end end)
			if o ~= nil then
				effectConnections[o] = nil
				hookedAnim[o] = nil
				processedInstances[o] = nil
			end
		else
			kept[#kept + 1] = e
		end
	end
	antiLagConnections = kept
end

local function lockEffectProperty(obj, property, value)
	setP(obj, property, value)
	local map = effectConnections[obj]
	if not map then
		map = {}
		effectConnections[obj] = map
	end
	if map[property] then return end
	local ok, signal = pcall(function() return obj:GetPropertyChangedSignal(property) end)
	if ok and signal then
		map[property] = trackAntiLagConnection(signal:Connect(function()
			if not on or not obj.Parent then return end
			local currentOk, current = pcall(function() return obj[property] end)
			if currentOk and current ~= value then
				setP(obj, property, value)
			end
		end), obj)
	end
end

local function disableVisualEffect(obj)
	if not obj or not obj.Parent then return end
	pcall(function()
		local post = obj:IsA("PostEffect")
		local atm = (not post) and obj:IsA("Atmosphere")
		local eff = post or obj:IsA("ParticleEmitter") or obj:IsA("Highlight")
			or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
			or obj:IsA("Clouds") or PART_OFF[obj.ClassName]
		if not (eff or atm) or mine(obj) then return end
		if eff then
			lockEffectProperty(obj, "Enabled", false)
		else
			lockEffectProperty(obj, "Density", 0)
			lockEffectProperty(obj, "Haze", 0)
			lockEffectProperty(obj, "Glare", 0)
		end
	end)
end

local function isPlayerCharacterObject(obj)
	local character = charOf(obj)
	return character ~= nil and Players:GetPlayerFromCharacter(character) ~= nil
end

local function processAntiLagInstance(obj)
	if not on or not obj or processedInstances[obj] then return end
	if obj.Parent == nil then return end
	processedInstances[obj] = true

	pcall(function()
		disableVisualEffect(obj)

		if not mine(obj) then
			if obj:IsA("ParticleEmitter") then
				setP(obj, "Rate", 0)
				setP(obj, "Lifetime", NumberRange.new(0, 0))
				setP(obj, "Texture", "")
			elseif obj:IsA("Beam") or obj:IsA("Trail") then
				setP(obj, "Texture", "")
			end
		end

		if obj:IsA("Accessory") then
			if H.hairOwner(obj) and H.isHairAccessory(obj) then
				H.hideHair(obj)
			end

		elseif obj:IsA("Animator") then
			if CFG.ANIM_INCLUDE_SELF or not mine(obj) then
				for _, track in ipairs(obj:GetPlayingAnimationTracks()) do
					H.stopUnlessWalk(track)
				end
				if not hookedAnim[obj] then
					hookedAnim[obj] = true
					trackAntiLagConnection(obj.AnimationPlayed:Connect(function(track)
						if on then H.stopUnlessWalk(track) end
					end), obj)
				end
			end

		elseif obj:IsA("Humanoid") then
			if not mine(obj) then
				if isPlayerCharacterObject(obj) then
					setP(obj, "NameDisplayDistance", FAR_NAME)
					setP(obj, "HealthDisplayDistance", FAR_NAME)
				else
					setP(obj, "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None)
				end
			end

		elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
			local character = charOf(obj)
			if character and Players:GetPlayerFromCharacter(character) then
				if obj:IsA("Shirt") then
					setP(obj, "ShirtTemplate", "")
				elseif obj:IsA("Pants") then
					setP(obj, "PantsTemplate", "")
				else
					setP(obj, "Graphic", "")
				end
			end

		elseif obj:IsA("BasePart") then
			if obj:IsA("Terrain") then return end
			local character = charOf(obj)
			local par = obj.Parent
			local hair = false
			if par and par:IsA("Accessory") then
				hair = H.hairOwner(par) and H.isHairAccessory(par)
			elseif character ~= nil then
				hair = H.nameHas(obj.Name, CFG.HAIR_KEYS)
			end
			if character ~= nil and Players:GetPlayerFromCharacter(character) ~= nil then

				if obj:IsA("MeshPart") then
					setP(obj, "TextureID", "")
				end
				setP(obj, "CastShadow", false)
				if character == LP.Character then return end
				if (obj.Position - camPos()).Magnitude > CFG.FAR_CHAR then
					setP(obj, "CastShadow", false)
					setP(obj, "Reflectance", 0)
					if obj:IsA("MeshPart") then
						setP(obj, "RenderFidelity", Enum.RenderFidelity.Performance)
					end
				end
				return
			end
			setP(obj, "Material", Enum.Material.SmoothPlastic)
			if obj:IsA("MeshPart") then
				setP(obj, "TextureID", "")
			end
			setP(obj, "Reflectance", 0)
			setP(obj, "CastShadow", false)
			if obj:IsA("MeshPart") then
				setP(obj, "RenderFidelity", Enum.RenderFidelity.Performance)
			end

		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			setP(obj, "Transparency", 1)
			setP(obj, "Texture", "")

		elseif obj:IsA("SpecialMesh") then
			local character = charOf(obj)
			if character and Players:GetPlayerFromCharacter(character) then
				setP(obj, "TextureId", "")
			end

		elseif obj:IsA("SurfaceAppearance") then
			local par = obj.Parent
			if par then
				shaderHold[obj] = par
				obj.Parent = nil
			end

		elseif obj:IsA("Explosion") or obj:IsA("ForceField") then
			setP(obj, "Visible", false)

		elseif obj:IsA("Sound") then
			local parent = obj.Parent
			if parent and parent:IsA("BasePart") and not mine(obj) and not isPlayerCharacterObject(obj) then
				if (parent.Position - camPos()).Magnitude > FAR_SND then
					setP(obj, "Volume", 0)
					lockEffectProperty(obj, "Playing", false)
				end
			end

		elseif obj:IsA("BillboardGui") then
			if not mine(obj) then setP(obj, "MaxDistance", FAR_GUI) end

		elseif obj:IsA("SoundEffect") then
			setP(obj, "Enabled", false)

		elseif obj:IsA("VideoFrame") then
			setP(obj, "Playing", false)
		end
	end)
end

local function pushQueue(obj)
	if not obj or processedInstances[obj] or scanQueued[obj] then return end
	scanWrite += 1
	scanQueue[scanWrite] = obj
	scanQueued[obj] = true
end

local function runWorker(session)
	local function alive()
		return on and loopId == session
	end
	local function drained()
		return scanRead > scanWrite and AL.list == nil and AL.rootIdx > #AL.roots
	end
	local errs = 0
	while alive() do
		local ok = pcall(function()
			local t0 = os.clock()
			local budget = CFG.FRAME_BUDGET
			if AL.fps < AL.ref * 0.6 then budget = budget * 0.5 end
			local limit = AL.batch
			local worked, visited = 0, 0

			while scanRead <= scanWrite and worked < limit and os.clock() - t0 < budget do
				local obj = scanQueue[scanRead]
				scanQueue[scanRead] = nil
				scanRead += 1
				if obj then
					scanQueued[obj] = nil
					processAntiLagInstance(obj)
					worked += 1
				end
			end

			while worked < limit and visited < limit * 8 and os.clock() - t0 < budget do
				if not AL.list then
					local root = AL.roots[AL.rootIdx]
					if root == nil then break end
					AL.roots[AL.rootIdx] = false
					AL.rootIdx += 1
					visited += 4
					if root and root.Parent then
						pushQueue(root)
						local okd, d = pcall(function() return root:GetDescendants() end)
						AL.list = okd and d or {}
						AL.listIdx, AL.pass = 1, 1
					end
				else
					local obj = AL.list[AL.listIdx]
					if obj == nil then
						if AL.pass == 1 then
							AL.pass, AL.listIdx = 2, 1
						else
							AL.list = nil
						end
					else
						AL.listIdx += 1
						visited += 1
						if AL.pass == 1 then
							if HIGH_CLASSES[obj.ClassName] then
								processAntiLagInstance(obj)
								worked += 1
							end
						elseif not processedInstances[obj] then
							processAntiLagInstance(obj)
							worked += 1
						end
					end
				end
			end
		end)
		if not ok then
			errs += 1
			if errs >= 5 then break end
		end
		if drained() then break end
		if AL.fps < 20 then task.wait(0.05) end
		if not alive() then break end
		adaptLoad(task.wait())
	end
	if loopId == session then
		AL.list, AL.roots, AL.rootIdx = nil, {}, 1
		scanQueue = {}
		scanRead, scanWrite = 1, 0
		scanQueued = setmetatable({}, { __mode = "k" })
		pcall(pruneConnections)
		scanRunning = false
	end
end

local function wakeWorker()
	if scanRunning or not on then return end
	scanRunning = true
	task.defer(runWorker, loopId)
end

local function enqueueAntiLagInstance(obj)
	if not on or not obj or processedInstances[obj] or scanQueued[obj] then return end
	pushQueue(obj)

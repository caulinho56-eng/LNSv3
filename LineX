	pcall(setOn, false)
	pcall(setNight, false)
	pcall(setJump, false)
	pcall(setSpeedOn, false)
	pcall(setNoFall, false)
	pcall(setNoclip, false)
	pcall(setWater, false)
	pcall(setEsp, false)
	pcall(setAimbot, false)
	pcall(V2.setNpcEsp, false)
	pcall(V2.setLootEsp, false)
	pcall(V2.stopSpectate)
	pcall(V3.shutdown)
	pcall(V3.trollStop)
	pcall(V3.extraStop)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	pcall(function() gui:Destroy() end)
	ENV.LNSLiteClose = nil
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end

local function nearBtn(pos, pad)
	local p, sz = aimBtn.AbsolutePosition, aimBtn.AbsoluteSize
	local inset = game:GetService("GuiService"):GetGuiInset()
	local cx, cy = p.X + sz.X / 2, p.Y + sz.Y / 2
	local dx = math.abs(pos.X - cx)
	local dy = math.min(math.abs(pos.Y - cy), math.abs(pos.Y + inset.Y - cy))
	return dx <= sz.X / 2 + pad and dy <= sz.Y / 2 + pad
end

local function pressOn()
	if AIM.moveBtn then
		dragArmed = true

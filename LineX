	function V2.hasKey(s, keys)
		s = string.lower(tostring(s or ""))
		for _, k in ipairs(keys) do
			if string.find(s, k, 1, true) then return true end
		end
		return false
	end

	function V2.toPart(o)
		if not o then return nil end
		if o:IsA("BasePart") then return o end
		if o:IsA("Attachment") then return V2.toPart(o.Parent) end
		if o:IsA("Model") then
			return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true)
		end
		if o:IsA("Tool") then
			return V2.toPart(o:FindFirstChild("Handle")) or o:FindFirstChildWhichIsA("BasePart", true)
		end
		return nil
	end

	function V2.newTracker(name, color, range, quick, resolve, keep)
		local T = { on = false, id = 0, objs = {}, conns = {}, folder = nil }

		local function drop(inst)
			local d = T.objs[inst]
			if not d then return end
			T.objs[inst] = nil
			pcall(function() d.hl:Destroy() end)
			pcall(function() d.bb:Destroy() end)
		end

		local function add(inst)
			if not T.on or not T.folder or T.objs[inst] or not inst.Parent then return end
			local a = inst.Parent
			while a and a ~= WS do
				if T.objs[a] then return end
				a = a.Parent
			end
			local part, label, hm, target = resolve(inst)
			if not part then return end
			local hl = mk("Highlight", {
				Adornee = target or part, Enabled = false, FillColor = color, OutlineColor = Color3.new(1, 1, 1),
				FillTransparency = 0.6, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, T.folder)
			local bb = mk("BillboardGui", {
				Adornee = part, Size = UDim2.fromOffset(140, hm and 40 or 30),
				StudsOffset = Vector3.new(0, hm and 2.6 or 1.6, 0),
				AlwaysOnTop = true, LightInfluence = 0, Enabled = false,
			}, T.folder)
			txt(bb, {
				Size = UDim2.new(1, 0, 0, 14), Text = tostring(label), TextSize = 12, TextColor3 = color,
				TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5,
			})
			local ds = txt(bb, {
				Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 14), Text = "",
				Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = GRAY,
				TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5,
			})
			local fl = nil
			if hm then
				local bg = mk("Frame", {
					Position = UDim2.new(0.5, -40, 0, 31), Size = UDim2.fromOffset(80, 5),
					BackgroundColor3 = OFFSW, BorderSizePixel = 0,
				}, bb)
				rnd(bg, 2)
				fl = mk("Frame", {
					Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(60, 220, 60), BorderSizePixel = 0,
				}, bg)
				rnd(fl, 2)
			end
			T.objs[inst] = { part = part, hl = hl, bb = bb, ds = ds, fill = fl, hum = hm, dist = 0 }
		end

		local function update()
			local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			local from = my and my.Position or camPos()
			local list = {}
			for inst, d in pairs(T.objs) do
				if not inst.Parent or not d.part.Parent or (keep and not keep(inst)) then
					drop(inst)
				elseif d.hum and d.hum.Health <= 0 then
					d.hl.Enabled = false
					d.bb.Enabled = false
				else
					d.dist = (d.part.Position - from).Magnitude
					list[#list + 1] = d
				end
			end
			table.sort(list, function(x, y) return x.dist < y.dist end)
			for i, d in ipairs(list) do
				local inR = d.dist <= range
				d.hl.Enabled = inR and i <= V2.MAX_HL
				d.bb.Enabled = inR and i <= V2.MAX_BB
				if d.bb.Enabled then
					d.ds.Text = math.floor(d.dist + 0.5) .. " studs"
					if d.hum and d.fill then
						local f = math.clamp(d.hum.Health / math.max(d.hum.MaxHealth, 1), 0, 1)
						d.fill.Size = UDim2.new(f, 0, 1, 0)
						d.fill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - f)), math.floor(220 * f), 40)
					end
				end
			end
		end

		local function scan(id)
			local n = 0
			for _, inst in ipairs(WS:GetDescendants()) do
				if not T.on or id ~= T.id then return end
				pcall(function()
					if quick(inst) then add(inst) end
				end)
				n += 1
				if n % 800 == 0 then task.wait() end
			end
		end

		return function(v)
			if v == T.on then return end
			T.on = v
			T.id += 1
			for _, c in ipairs(T.conns) do pcall(function() c:Disconnect() end) end
			T.conns = {}
			for inst in pairs(T.objs) do drop(inst) end
			T.objs = {}
			if T.folder then
				pcall(function() T.folder:Destroy() end)
				T.folder = nil
			end
			if not v then return end
			T.folder = mk("Folder", { Name = name }, gui)
			local id = T.id
			table.insert(T.conns, WS.DescendantAdded:Connect(function(i)
				pcall(function()
					if T.on and quick(i) then task.delay(0.4, function() pcall(add, i) end) end
				end)
			end))
			local acc = 0
			table.insert(T.conns, RunService.Heartbeat:Connect(function(dt)
				acc += dt
				if acc < 0.2 then return end
				acc = 0
				pcall(update)
			end))
			task.spawn(scan, id)
		end
	end

	V2.setNpcEsp = V2.newTracker("LNSNPCESP", ORANGE, 1500,
		function(i) return i:IsA("Humanoid") end,
		function(i)
			local m = i.Parent
			if not (m and m:IsA("Model")) or m == LP.Character or Players:GetPlayerFromCharacter(m) then return nil end
			local part = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or V2.toPart(m)
			if not (part and part:IsA("BasePart")) then return nil end
			return part, m.Name, i, m
		end,
		function(i)
			local m = i.Parent
			return m ~= nil and m ~= LP.Character and not Players:GetPlayerFromCharacter(m)
		end)

	V2.setLootEsp = V2.newTracker("LNSLOOTESP", Color3.fromRGB(255, 215, 60), 800,
		function(i)
			if i:IsA("Tool") or i:IsA("ProximityPrompt") then return true end
			if i:IsA("BasePart") or i:IsA("Model") then return V2.hasKey(i.Name, V2.LOOT_KEYS) end
			return false
		end,
		function(i)
			if charOf(i) then return nil end
			if i:IsA("ProximityPrompt") then
				local p = i.Parent
				if not (p and V2.hasKey(i.ActionText .. " " .. i.ObjectText .. " " .. p.Name, V2.PROMPT_KEYS)) then
					return nil
				end
				if p:IsA("Attachment") then p = p.Parent end
				local part = V2.toPart(p)
				if not part then return nil end
				local label = (i.ObjectText ~= "" and i.ObjectText) or (i.ActionText ~= "" and i.ActionText) or p.Name
				return part, label, nil, (p:IsA("Model") and p) or part
			end
			local part = V2.toPart(i)
			if not part then return nil end
			return part, i.Name, nil, ((i:IsA("Model") or i:IsA("BasePart")) and i) or part
		end,
		nil)

	function V2.stopSpectate()
		V2.specTarget = nil
		if V2.specConn then
			V2.specConn:Disconnect()
			V2.specConn = nil
		end
		local cam = WS.CurrentCamera
		local h = hum()
		if cam and h then pcall(function() cam.CameraSubject = h end) end
	end

	function V2.spectate(p)
		V2.stopSpectate()
		if not (p and p.Parent) then return false end
		V2.specTarget = p
		V2.specConn = RunService.RenderStepped:Connect(function()
			local cam = WS.CurrentCamera
			local t = V2.specTarget
			if not cam then return end
			if not (t and t.Parent) then
				V2.stopSpectate()
				return
			end
			local c = t.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h and cam.CameraSubject ~= h then
				pcall(function() cam.CameraSubject = h end)
			end
		end)
		return true
	end
end


	ENV.LNS_AK = AK
	local BAN_KEYS = { "ban", "kick", "cheat", "exploit", "anticheat", "detect", "violation", "suspicious" }

	local function banRemote(r)
		local ok, n = pcall(function() return string.lower(r.Name) end)
		if not ok then return false end
		for _, k in ipairs(BAN_KEYS) do
			if string.find(n, k, 1, true) then return true end
		end
		return false
	end


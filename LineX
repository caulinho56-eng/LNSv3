do
	local MIN_S, MAX_S = 40, 120
	local row = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = ROW, BorderSizePixel = 0, LayoutOrder = 2,
	}, pSet)
	rnd(row, 10)
	local lbl = txt(row, {
		Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22),
		Text = "Tamanho da Logo: " .. miniSize, TextSize = 13,
	})
	local b = mk("Frame", {
		Position = UDim2.fromOffset(12, 40), Size = UDim2.new(1, -24, 0, 8), BackgroundColor3 = OFFSW,
		BorderSizePixel = 0, Active = true,
	}, row)
	rnd(b, 4)
	local rel0 = (miniSize - MIN_S) / (MAX_S - MIN_S)
	local f = mk("Frame", { Size = UDim2.new(rel0, 0, 1, 0), BackgroundColor3 = ORANGE, BorderSizePixel = 0 }, b)
	rnd(f, 4)
	local k = mk("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = UDim2.new(rel0, -7, 0.5, -7),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, b)
	rnd(k, 7)
	table.insert(rowsOf["Settings"], { row, "Tamanho da Logo" })

	local function setX(x)
		local rel = math.clamp((x - b.AbsolutePosition.X) / math.max(b.AbsoluteSize.X, 1), 0, 1)
		miniSize = math.floor(MIN_S + rel * (MAX_S - MIN_S) + 0.5)
		f.Size = UDim2.new(rel, 0, 1, 0)
		k.Position = UDim2.new(rel, -7, 0.5, -7)
		lbl.Text = "Tamanho da Logo: " .. miniSize
		if collapsed then
			root.Size = UDim2.fromOffset(miniSize, miniSize)
			rootCorner.CornerRadius = UDim.new(0, math.floor(miniSize / 2))
		end
	end

	local sl = false
	table.insert(conns, b.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sl = true
			setX(i.Position.X)
		end
	end))
	table.insert(conns, UIS.InputChanged:Connect(function(i)
		if sl and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setX(i.Position.X)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sl = false
		end
	end))
end

